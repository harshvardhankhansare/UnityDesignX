# UnityDesignX Configuration Settings

# Application Environment
APP_NAME="UnityDesignX"
APP_TAGLINE="The Art of Fine Living"
APP_URL="http://localhost/InteriorDesign"
APP_DEBUG=true

# Database Connection (MySQL / MariaDB)
DB_HOST="localhost"
DB_PORT="3307"
DB_NAME="unity"
DB_USER="root"
DB_PASS=""

# Email Notification & SMTP Settings
ADMIN_EMAIL="admin@unitydesign.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@unitydesign.com"
ENABLE_EMAIL_NOTIFICATIONS=true
